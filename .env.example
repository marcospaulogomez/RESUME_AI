# true: teste por texto, sem chamadas à API. false: IA e transcrição reais.
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Caminhos relativos são resolvidos a partir da pasta do projeto.
DATABASE_PATH=data/interviews.db
DATA_RETENTION_DAYS=30
DATA_CONTROLLER=Organização responsável pelo teste local
PRIVACY_CONTACT=responsavel@example.com
